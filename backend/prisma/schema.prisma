
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        String     @id @default(cuid())
  email     String     @unique
  senha     String
  nome      String
  rendaMensal Decimal    @db.Decimal(10, 2) @default(0)
  metaEconomiaMensal Decimal    @db.Decimal(10, 2) @default(0)
  dataCriacao DateTime   @default(now())
  dataAtualizacao DateTime?   @updatedAt

  movimentacoes Movimentacao[]
  categorias   Categoria[]
  reports      Relatorio[]
  historicoReflexoes HistoricoReflexao[]

  @@map("usuarios")
}

model Categoria {
  id        String     @id @default(cuid())
  userId    String
  user      Usuario       @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome      String
  color     String?    @default("#000000")
  icon      String?
  dataCriacao DateTime   @default(now())
  dataAtualizacao DateTime?   @updatedAt

  movimentacoes Movimentacao[]

  @@unique([userId, nome])
  @@map("categorias")
}

model Movimentacao {
  id          String   @id @default(cuid())
  userId      String
  user        Usuario     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoriaId  String
  categoria    Categoria @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  quantia      Decimal  @db.Decimal(10, 2)
  descricao String?
  data        DateTime @default(now())
  tipo        String   // "receita" | "despesa"
  metodo      String?  // "dinheiro" | "cartão" | "transferência_bancária"
  dataCriacao   DateTime @default(now())
  dataAtualizacao   DateTime? @updatedAt

  @@map("movimentacoes")
}

model Relatorio {
  id        String   @id @default(cuid())
  userId    String
  user      Usuario     @relation(fields: [userId], references: [id], onDelete: Cascade)
  titulo     String
  tipo      String   // "mensal" | "anual" | "categoria" | "semanal"
  dados      Json
  dataCriacao DateTime @default(now())
  dataAtualizacao DateTime? @updatedAt

  @@map("relatorios")
}

model HistoricoReflexao {
  id        String   @id @default(cuid())
  userId    String
  user      Usuario     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mes      String
  comentario   String
  dataCriacao DateTime @default(now())
  dataAtualizacao DateTime? @updatedAt

  @@map("historico_reflexoes")
}
